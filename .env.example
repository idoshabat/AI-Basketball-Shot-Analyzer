# Frontend, Vercel
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# Backend, Render
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANALYSES_TABLE=analyses
SUPABASE_STORAGE_BUCKET=shot-analyses
SUPABASE_UPLOAD_ANNOTATED_VIDEO=true
SUPABASE_UPLOAD_ORIGINAL_VIDEO=false
SUPABASE_UPLOAD_DEBUG_FILES=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-vercel-app.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app|http://127\.0\.0\.1:5173|http://localhost:5173
ANALYSIS_RETENTION_DAYS=7

# Optional YOLO ball tracking
# Install with: pip install -r requirements-yolo.txt
# Put a basketball/sports-ball YOLO model at model/basketball_yolo.pt, or set an explicit path.
BALL_DETECTION_BACKEND=auto
BALL_DETECTION_MODEL_PATH=model/basketball_yolo.pt
BALL_DETECTION_CONFIDENCE=0.05
BALL_DETECTION_IMAGE_SIZE=1280

# Optional Roboflow hosted ball detector.
# Example model id format: basketball-detector-n4omu/1
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com
ROBOFLOW_FRAME_STRIDE=2
ROBOFLOW_MAX_WORKERS=8
ROBOFLOW_RELEASE_WINDOW_BEFORE=18
ROBOFLOW_RELEASE_WINDOW_AFTER=42
